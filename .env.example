# Required: token from @BotFather
TELEGRAM_TOKEN=
# Required: comma-separated chat IDs. Unknown chats are logged once, so start
# the bot, message it, and copy your ID from the logs (OSS-03).
ALLOWED_CHAT_IDS=

# Matches docker compose defaults; change for local runs outside compose.
DATABASE_URL=postgres://receh:receh@localhost:5432/receh?sslmode=disable

# Optional
TZ=Asia/Jakarta
LOCALE=id
LOG_LEVEL=info

# Defaults for each chat on first use (changeable per chat later)
CYCLE_START_DAY=25
REPORT_TYPES=weekly,monthly
REPORT_HOUR=20
